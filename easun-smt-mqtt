    }

  Serial.println ("Sending command HGEN");
  expectedResponse = rq_HGEN;
  Serial2.print (HGEN);
  delay (2000);
  if (Serial2.available ())
    {
      Serial.println ("Printing reply from inverter:");
      stringOne = Serial2.readStringUntil ('\r');
      std::string test = stringOne.c_str ();

      process_line_ (test);
      stringOne = "";
    }
  if (!mqttclient.connected ())
    {
      reconnect ();
    }

  Serial.println ("Sending command HBAT");
  expectedResponse = rq_HBAT;
  Serial2.print (HBAT);
  delay (2000);
  if (Serial2.available ())
    {
      Serial.println ("Printing reply from inverter:");
      stringOne = Serial2.readStringUntil ('\r');
      std::string test = stringOne.c_str ();

      process_line_ (test);
