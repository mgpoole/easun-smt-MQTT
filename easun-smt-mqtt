  Serial.println ("Sending command HOP");
  expectedResponse = rq_HOP;
  Serial2.print (HOP);
  delay (2000);
  if (Serial2.available ())
    {
      Serial.println ("Printing reply from inverter:");
      stringOne = Serial2.readStringUntil ('\r');

      std::string test = stringOne.c_str ();

      process_line_ (test);
      stringOne = "";
    }

  Serial.println ("Sending command HPV");
  expectedResponse = rq_HPV;
  Serial2.print (HPV);
